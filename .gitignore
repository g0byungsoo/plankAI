build/
DerivedData/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
xcuserdata/
**/xcuserdata/

# Swift Package Manager
.build/
Packages/*/. build/
Package.resolved

# CocoaPods
Pods/

# Environment
.env
.env.*

# macOS
.DS_Store
*.swp
*~

# IDE
.idea/
*.code-workspace
AuthKey_*.p8
*.p8
.gstack/

# Device captures + raw source art (kept local; not app build inputs)
screenshots/
/Resources/
generated_illustrations/
.claude/scheduled_tasks.lock

# Local backups (re-encoded asset originals, kept outside git for rollback)
.local-backups/

# Supabase CLI local state
supabase/.temp/

# Build-verification screenshots (kept local, like screenshots/)
docs/retention_v1_1_2/
__pycache__/
docs/app_v4/evidence/
docs/app_v5/evidence/
site/.vercel/

# Founder device-walk reference screenshots (local reference, never committed)
jeni-onboarding/
jeni-inapp/

# Onboarding v8 loop films (kept local, like the other evidence dirs)
docs/onboarding_v8/evidence/

# The demo stack's dashboard env is committed on purpose: it holds
# only the Supabase CLI's fixed LOCAL keys (public constants) so any
# session can replay the clinic demo without reconstructing state.
!clinic/.env.demo

# The demo stack's migration chain is GENERATED from the canonical
# SQL by Scripts/demo/sync_migrations.sh — copies must never drift in
# git. The workdir config is committed; the copies are not.
demo/supabase/migrations/
demo/supabase/.branches/
demo/supabase/.temp/
