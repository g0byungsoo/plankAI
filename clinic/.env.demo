# The Jeni Care DEMO build — points the dashboard at the local demo
# stack (scripts/demo/). Run it with:
#
#   npm run dev -- --mode demo
#
# VITE_CARE_ENV stays `development` because that is what the local
# stack's server declares (private.config['environment']); the boot
# guard compares the two and must find them equal. The key below is
# the Supabase CLI's fixed local publishable key — a public constant,
# identical on every machine, reachable only on 127.0.0.1.
VITE_CARE_ENV=development
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
